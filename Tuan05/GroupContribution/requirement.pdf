     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train Shape:  (1460, 76)\n",
      "Test Shape:  (1459, 75)\n"
     ]
    }
   ],
   "source": [
    "DATA_TYPE = \"cleaned\"\n",
    "DATA_DIR = f\"./data/{DATA_TYPE}\"\n",
    "\n",
    "df_train = pd.read_csv(f\"{DATA_DIR}/train.csv\")\n",
    "df_test = pd.read_csv(f\"{DATA_DIR}/test.csv\")\n",
    "n_train = len(df_train)\n",
    "print('Train Shape: ', df_train.shape)\n",
    "print('Test Shape: ', df_test.shape)"
   ]
  },
